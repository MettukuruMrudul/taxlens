# Copy this file to .env (the real .env is never committed to git).
DATABASE_URL=postgresql://taxlens:taxlens@localhost:5433/taxlens
REDIS_URL=redis://localhost:6379/0
RAW_DIR=data/raw
# Identify yourself to irs.gov when downloading
USER_AGENT=TaxLens research project (contact: your-email@example.com)

# --- Answer generation ---------------------------------------------------------
# none      = quote IRS text directly (no API key needed)
# openai    = OpenAI, or any OpenAI-compatible server (vLLM, Ollama) via LLM_BASE_URL
# anthropic = Anthropic API
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_S=60
# Thinking models (e.g. Gemini 3.x): allow less internal reasoning so answers come faster.
# Leave empty for models that don't support it.
LLM_REASONING_EFFORT=
# Local Ollama example:  LLM_PROVIDER=openai  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b
# Gemini free tier:      LLM_PROVIDER=openai  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                        LLM_MODEL=gemini-3.5-flash-lite  (leave LLM_REASONING_EFFORT empty: on Gemini,
#                        setting it switches thinking ON, which slows answers and can return empty text)
#                        Check models and speed: python -m taxlens.llm_check <model> <model> ...

# --- Optional neural models (pip install -r requirements-ml.txt) -------------
EMBED_MODEL=
RERANK_MODEL=
NLI_MODEL=
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- API -----------------------------------------------------------------------
# Leave empty on your laptop to use the built-in development secret.
# Anywhere else, set a long random value (the API refuses to start with
# ALLOW_DEV_TOKENS=false and no secret):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ALLOW_DEV_TOKENS=true
RATE_LIMIT=20/minute
RATE_LIMIT_STORAGE=memory://
CORS_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=
